# Global .gitignore for MediVault

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert
*.pfx

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build Outputs
dist/
server/dist/
build/
client/.next/
client/out/
client/build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server/*.log

# OS & Temp Files
.DS_Store
Thumbs.db
tmp/
temp/
.vercel
.netlify
server/.env
server/.env
