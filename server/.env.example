# Server Environment Variables Template
# Copy this file to .env and fill in your actual values

# Application Environment
NODE_ENV=development
PORT=5000

# Database Configuration
# Get your MongoDB connection string from: https://www.mongodb.com/atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/medivault?retryWrites=true&w=majority

# JWT Secret Key
# Generate a strong secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters recommended
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters-long

# CORS Configuration
# For local development: http://localhost:3000
# For production: https://your-frontend-domain.vercel.app
CORS_ORIGIN=http://localhost:3000

# Email Configuration (for OTP)
# For Gmail: smtp.gmail.com (port 587)
# You need to generate an "App Password" from Google Account settings
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Optional: Email From Name
EMAIL_FROM_NAME=MediVault
